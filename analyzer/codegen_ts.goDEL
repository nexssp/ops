package analyzer

import (
	"bytes"
	"encoding/json"
	"fmt"
	"sort"
	"strings"
)

// GenerateTypeScriptSDK produces the complete generated tree for
// ui/src/lib/_gen/. Paths are relative to ui/src/lib/.
func GenerateTypeScriptSDK(report *Report) []GeneratedFile {
	collidingNames, tsStructs := analyzeCollisions(report.Structs)
	reachable := computeReachableStructs(report, tsStructs, collidingNames)

	var files []GeneratedFile

	files = append(files,
		GeneratedFile{
			Path:      "_gen/api/client.ts",
			Content:   generateClientFile(),
			Overwrite: true,
		},
		GeneratedFile{
			Path:      "_gen/api/types.ts",
			Content:   generateTypesFile(reachable, tsStructs, report.Structs, collidingNames),
			Overwrite: true,
		},
		GeneratedFile{
			Path:      "_gen/api/index.ts",
			Content:   generateIndexFile(report, tsStructs, collidingNames),
			Overwrite: true,
		},
		GeneratedFile{
			Path:      "_gen/index.ts",
			Content:   generateTopBarrel(),
			Overwrite: true,
		},
	)

	files = append(files, generateStoreFiles(report, collidingNames)...)

	return files
}

func generateTopBarrel() []byte {
	return []byte(`// ⚠️ DO NOT EDIT — Auto-generated by nexssp/ops
//
// Single entry point for every generated artefact.
// App code should normally import from $lib/api and $lib/stores/* instead.

export * from './api';
export * from './stores';
`)
}

func generateClientFile() []byte {
	return []byte(`// ⚠️ DO NOT EDIT — Auto-generated by nexssp/ops

export enum ErrorKind { BadRequest = "BadRequest", Unauthorized = "Unauthorized", Internal = "Internal" }
export type IsoDateString = string;
export interface AppError { error: ErrorKind; message: string; details?: any[]; }
export class APIError extends Error { constructor(public status: number, public data: AppError) { super(data.message); } }

export type FetchOptions = { method: string; path: string; body?: unknown };
export let _fetcher = async <T = unknown>(opts: FetchOptions): Promise<T> => {
  throw new Error("Fetcher not configured. Call setFetcher() first.");
};
export function setFetcher(fn: typeof _fetcher) { _fetcher = fn; }

export function resolvePath(pattern: string, params?: unknown): string {
  if (!params || typeof params !== "object") return pattern;
  let resolved = pattern;
  const query = new URLSearchParams();
  const pathKeys = new Set<string>();

  for (const [key, val] of Object.entries(params as Record<string, unknown>)) {
    const placeholder = "{" + key + "}";
    if (resolved.includes(placeholder)) {
      resolved = resolved.replaceAll(placeholder, encodeURIComponent(String(val)));
      pathKeys.add(key);
    }
  }

  for (const [key, val] of Object.entries(params as Record<string, unknown>)) {
    if (!pathKeys.has(key) && val != null && val !== "") {
      query.append(key, String(val));
    }
  }

  const qs = query.toString();
  return qs ? resolved + "?" + qs : resolved;
}
`)
}

func generateTypesFile(reachable map[string]StructDefinition, tsStructs map[string]StructDefinition, rawStructs map[string]StructDefinition, colliding map[string]bool) []byte {
	var buf bytes.Buffer
	buf.WriteString("// ⚠️ DO NOT EDIT\nimport { z } from 'zod';\nimport type { IsoDateString } from './client';\n\n")

	keys := make([]string, 0, len(reachable))
	nameCounts := make(map[string]int)
	for k, v := range reachable {
		keys = append(keys, k)
		nameCounts[v.Name]++
	}
	sort.Strings(keys)

	for _, k := range keys {
		sDef := reachable[k]
		if len(sDef.Fields) == 0 {
			continue
		}

		type fieldZod struct {
			expr    string
			unknown []string
		}
		zods := make([]fieldZod, len(sDef.Fields))
		for i, f := range sDef.Fields {
			e, u := mapFieldToZod(f, tsStructs, rawStructs, colliding)
			zods[i] = fieldZod{expr: e, unknown: u}
		}

		tsName := targetTSName(sDef, colliding)
		fmt.Fprintf(&buf, "export interface %s {\n", tsName)
		for i, f := range sDef.Fields {
			if len(zods[i].unknown) > 0 {
				fmt.Fprintf(&buf, "  // ⚠️ unmapped validator rules on %q: %s\n",
					f.Key, strings.Join(zods[i].unknown, ", "))
			}
			opt := "?"
			if f.Required {
				opt = ""
			}
			fmt.Fprintf(&buf, "  %s%s: %s;\n", f.Key, opt, f.Type)
		}
		buf.WriteString("}\n\n")

		fmt.Fprintf(&buf, "export const %sSchema = z.object({\n", tsName)
		for i, f := range sDef.Fields {
			fmt.Fprintf(&buf, "  %s: %s,\n", f.Key, zods[i].expr)
		}
		buf.WriteString("});\n\n")

		if !colliding[sDef.Name] && nameCounts[sDef.Name] == 1 && sDef.Name != tsName {
			fmt.Fprintf(&buf, "export type %s = %s;\nexport const %sSchema = %sSchema;\n\n", sDef.Name, tsName, sDef.Name, tsName)
		}
	}
	return buf.Bytes()
}

func generateIndexFile(report *Report, tsStructs map[string]StructDefinition, colliding map[string]bool) []byte {
	var buf bytes.Buffer
	buf.WriteString("// ⚠️ DO NOT EDIT\nexport * from './client';\nexport * from './types';\n")
	buf.WriteString("import { resolvePath, _fetcher } from './client';\nimport * as Types from './types';\n\n")

	buf.WriteString(`export interface EndpointMeta {
  name: string;
  method: string;
  path: string;
  streaming?: boolean;
  raw?: boolean;
  reqFields?: any[];
}
export const endpointMeta: Record<string, EndpointMeta> = {
`)
	for _, act := range report.Actions {
		if act.Scope != "public" || act.Path == "" {
			continue
		}
		mName := toCamelCase(act.Name)
		fieldsJSON, _ := json.Marshal(act.ReqFields)
		if len(act.ReqFields) == 0 {
			fieldsJSON = []byte("[]")
		}
		fmt.Fprintf(&buf,
			"  %s: { name: %q, method: %q, path: %q, streaming: %v, raw: %v, reqFields: %s },\n",
			mName, act.Name, act.Method, act.Path,
			act.Streaming, act.Raw, string(fieldsJSON),
		)
	}
	buf.WriteString("};\n\nexport const api = {\n")

	for _, act := range report.Actions {
		if act.Scope != "public" || act.Path == "" {
			continue
		}
		if act.Streaming || act.Raw {
			continue
		}

		mName := toCamelCase(act.Name)
		rawReqT := resolveActionTypeTS(act, true, tsStructs, report.Structs, colliding)
		rawResT := resolveActionTypeTS(act, false, tsStructs, report.Structs, colliding)

		reqT := formatTSNamespaceType(rawReqT, tsStructs)
		resT := formatTSNamespaceType(rawResT, tsStructs)

		valCheck := ""
		if sDef, ok := resolveActionStruct(act, true, report.Structs); ok && len(sDef.Fields) > 0 {
			valCheck = fmt.Sprintf("\n    Types.%sSchema.parse(req ?? {});", targetTSName(sDef, colliding))
		}

		if reqT == "void" {
			fmt.Fprintf(&buf,
				"  %s: (): Promise<%s> => {\n    return _fetcher({ method: '%s', path: resolvePath('%s') });\n  },\n\n",
				mName, resT, act.Method, act.Path,
			)
			continue
		}

		if act.Method == "GET" || act.Method == "DELETE" {
			fmt.Fprintf(&buf,
				"  %s: (req?: %s): Promise<%s> => {%s\n    return _fetcher({ method: '%s', path: resolvePath('%s', req) });\n  },\n\n",
				mName, reqT, resT, valCheck, act.Method, act.Path,
			)
			continue
		}

		fmt.Fprintf(&buf,
			"  %s: (req: %s): Promise<%s> => {%s\n    return _fetcher({ method: '%s', path: resolvePath('%s', req), body: req });\n  },\n\n",
			mName, reqT, resT, valCheck, act.Method, act.Path,
		)
	}

	buf.WriteString("};\n")
	return buf.Bytes()
}

// formatTSNamespaceType decides whether a type reference needs the `Types.`
// prefix. Only names that were actually emitted into types.ts get the
// prefix — anything else falls back to a safe builtin so the emitted client
// never references an undefined type.
func formatTSNamespaceType(t string, tsStructs map[string]StructDefinition) string {
	if t == "" || t == "void" || t == "unknown" {
		return "void"
	}
	switch t {
	case "string", "number", "boolean", "IsoDateString":
		return t
	}
	if strings.HasPrefix(t, "Record<") || strings.HasSuffix(t, "[]") || strings.Contains(t, "|") {
		return t
	}
	if _, ok := tsStructs[t]; ok {
		return "Types." + t
	}
	return "Record<string, unknown>"
}
