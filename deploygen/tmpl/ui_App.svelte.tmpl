        <button onclick={() => applyFontSize(rootFontSize + 2)} class="h-5 w-5 flex items-center justify-center rounded hover:bg-[var(--bg-elevated)] text-[var(--ink-secondary)] hover:text-[var(--ink)]" title="Increase font size 2px">A+</button>
      </div>

      <button onclick={toggleContrast} class="h-6 px-1.5 rounded border border-[var(--border)] bg-[var(--bg)] text-[10px] text-[var(--ink-secondary)] hover:text-[var(--ink)] font-mono">CONTRAST</button>

      <!-- Theme Switcher -->
      <div class="flex rounded border border-[var(--border)] bg-[var(--bg)] p-0.5 text-[10px] font-mono">
        <button onclick={() => applyTheme('dark')} class="h-5 px-1.5 rounded {theme === 'dark' ? 'bg-[var(--bg-elevated)] text-[var(--accent)] font-bold' : 'text-[var(--ink-tertiary)] hover:text-[var(--ink)]'}">DARK</button>
        <button onclick={() => applyTheme('light')} class="h-5 px-1.5 rounded {theme === 'light' ? 'bg-[var(--bg-elevated)] text-[var(--accent)] font-bold' : 'text-[var(--ink-tertiary)] hover:text-[var(--ink)]'}">LIGHT</button>
      </div>
    </div>
  </header>

  <!-- ── 2. MAIN 3-PANE WORKBENCH BODY ── -->
  <main class="flex flex-1 overflow-hidden select-text relative">

    {#if activeTab === 'explorer'}
      <!-- LEFT PANE: Action Directory (240px) -->
      <aside class="w-64 flex-shrink-0 bg-[var(--bg-raised)] border-r border-[var(--border)] flex flex-col overflow-hidden">
        <div class="p-3 border-b border-[var(--border)] flex flex-col gap-2">
          <input type="search" bind:value={searchFilter} placeholder="FILTER ACTIONS (/)..." class="w-full bg-[var(--bg)] border border-[var(--border)] rounded px-2.5 py-1.5 font-mono text-xs text-[var(--ink)] focus-ring placeholder-[var(--ink-quaternary)]" />
          <div class="flex gap-1 overflow-x-auto pb-1 no-scrollbar">
            {#each allTags as tag}
              <button onclick={() => selectedTag = tag} class="px-2 py-0.5 text-[10px] font-mono uppercase font-bold rounded border transition-colors {selectedTag === tag ? 'bg-[var(--accent)] text-[#0c0c0e] border-[var(--accent)]' : 'border-[var(--border)] bg-[var(--bg)] text-[var(--ink-tertiary)] hover:text-[var(--ink)]'}">
                {tag}
              </button>
            {/each}
          </div>
        </div>

        <div class="px-3 py-2 text-[10px] font-mono uppercase tracking-widest text-[var(--ink-tertiary)] flex justify-between">
          <span>Registered Actions</span>
          <span>{filteredEndpoints.length} / {allEndpoints.length}</span>
        </div>

        <div class="flex-1 overflow-y-auto px-2 pb-3 space-y-1">
          {#each filteredEndpoints as ep}
            <button onclick={() => selectEndpoint(ep.name)} class="w-full text-left p-2 rounded border font-mono transition-all focus-ring {selectedMethodName === ep.name ? 'border-[var(--accent)] bg-[var(--accent-dim)]' : 'border-[var(--border)] bg-[var(--bg)] hover:bg-[var(--bg-elevated)]'}">
              <div class="flex items-center justify-between gap-1 mb-1">
                <span class="text-xs font-bold text-[var(--ink)] truncate">{ep.name}</span>
                <span class="pill {ep.method === 'POST' ? 'pill-green' : ep.method === 'GET' ? 'pill-blue' : 'pill-amber'} text-[9px]">{ep.method}</span>
              </div>
              <div class="text-[10px] text-[var(--ink-tertiary)] truncate">{ep.path}</div>
            </button>
          {/each}
        </div>
      </aside>

      <!-- CENTER PANE: Action Inspector & CodeGen -->
      <section class="flex-1 flex flex-col overflow-y-auto bg-[var(--bg)] p-5 space-y-5">
        {#if currentMeta}
          <!-- Action Hero Header -->
          <div class="border border-[var(--border)] bg-[var(--bg-raised)]">
            <div class="p-4 border-b border-[var(--border)] flex flex-wrap items-center justify-between gap-3">
              <div>
                <div class="flex items-center gap-2.5 mb-1">
                  <span class="pill {currentMeta.method === 'POST' ? 'pill-green' : currentMeta.method === 'GET' ? 'pill-blue' : 'pill-amber'}">{currentMeta.method}</span>
                  <h2 class="font-mono text-sm font-bold text-[var(--ink)] tracking-tight">{currentMeta.name}</h2>
                  {#if currentMeta.node}
                    <span class="text-[10px] font-mono text-[var(--ink-tertiary)] border border-[var(--border)] px-1.5 rounded">NODE: {currentMeta.node}</span>
                  {/if}
                </div>
                <p class="text-xs text-[var(--ink-secondary)]">{currentMeta.description || 'Executes action ' + currentMeta.name}</p>
              </div>

              <div class="flex items-center gap-2">
                <button onclick={() => activeSchemaModal = 'req'} class="px-2.5 py-1 rounded bg-[var(--bg-elevated)] hover:bg-[var(--bg-hover)] border border-[var(--border)] text-[var(--accent)] text-xs font-mono font-medium focus-ring">
                  Req: {currentMeta.reqType}
                </button>
                <button onclick={() => activeSchemaModal = 'res'} class="px-2.5 py-1 rounded bg-[var(--bg-elevated)] hover:bg-[var(--bg-hover)] border border-[var(--border)] text-[var(--positive)] text-xs font-mono font-medium focus-ring">
                  Res: {currentMeta.resType}
                </button>
              </div>
            </div>

            <!-- Capabilities Strip -->
            <div class="grid grid-cols-4 sm:grid-cols-6 divide-x divide-[var(--border)] text-center text-[10px] font-mono py-2 bg-[var(--bg-elevated)] text-[var(--ink-tertiary)]">
              <div class="p-1"><span>IDEMPOTENT</span><br/><strong class="{currentMeta.idempotent ? 'text-[var(--positive)]' : 'text-[var(--ink-tertiary)]'}">{currentMeta.idempotent ? 'YES' : 'NO'}</strong></div>
              <div class="p-1"><span>TIMEOUT</span><br/><strong class="text-[var(--ink)]">{currentMeta.timeoutMs || 0}ms</strong></div>
              <div class="p-1"><span>RETRIES</span><br/><strong class="text-[var(--ink)]">{currentMeta.retryMax || 0}x</strong></div>
              <div class="p-1"><span>RATE LIMIT</span><br/><strong class="text-[var(--accent)]">{currentMeta.rateLimit || 'none'}</strong></div>
              <div class="p-1"><span>AUTH</span><br/><strong class="{currentMeta.requiresAuth ? 'text-[var(--negative)]' : 'text-[var(--positive)]'}">{currentMeta.requiresAuth ? 'REQUIRED' : 'PUBLIC'}</strong></div>
              <div class="p-1"><span>BULKHEAD</span><br/><strong class="text-[var(--ink)]">{currentMeta.concurrencyLimit || 'unbounded'}</strong></div>
            </div>
          </div>

          <!-- Payload Builder Panel -->
          <div class="border border-[var(--border)] bg-[var(--bg-raised)]">
            <div class="px-4 py-2.5 border-b border-[var(--border)] bg-[var(--bg-elevated)] flex items-center justify-between">
              <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-[var(--ink-secondary)]">Request Payload Builder</span>
              <div class="flex items-center gap-2">
                <button onclick={fillSampleData} class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-[var(--accent-dim)] text-[var(--accent)] border border-[rgba(201,169,110,0.3)] hover:bg-[var(--accent-glow)] focus-ring">
                  ✨ Sample Data
                </button>
                <div class="flex rounded border border-[var(--border)] bg-[var(--bg)] p-0.5 text-[10px] font-mono">
                  <button onclick={() => { inputMode = 'form'; syncJsonToForm(); }} class="px-2 py-0.5 rounded {inputMode === 'form' ? 'bg-[var(--bg-elevated)] text-[var(--accent)] font-bold' : 'text-[var(--ink-tertiary)]'}">Form View</button>
                  <button onclick={() => { inputMode = 'json'; syncFormToJson(); }} class="px-2 py-0.5 rounded {inputMode === 'json' ? 'bg-[var(--bg-elevated)] text-[var(--accent)] font-bold' : 'text-[var(--ink-tertiary)]'}">Raw JSON</button>
                </div>
              </div>
            </div>

            {#if inputMode === 'form'}
              <div class="p-4 grid grid-cols-1 md:grid-cols-2 gap-4">
                {#each currentMeta.fields || currentMeta.reqFields || [] as f}
                  <div class="flex flex-col gap-1">
                    <label class="text-xs font-mono font-medium text-[var(--ink-secondary)] flex justify-between">
                      <span>{f.label} ({f.key})</span>
                      {#if f.required}<span class="text-[var(--negative)] font-bold">*</span>{/if}
                    </label>
                    <input
                      type="{f.type === 'number' ? 'number' : 'text'}"
                      bind:value={formData[f.key]}
                      oninput={validateClientSide}
                      class="w-full bg-[var(--bg)] border border-[var(--border)] px-2.5 py-1.5 font-mono text-xs text-[var(--ink)] focus-ring"
                    />
                    {#if validationErrors[f.key]}
                      <span class="text-[10px] text-[var(--negative)] font-mono">{validationErrors[f.key]}</span>
                    {/if}
                  </div>
                {:else}
                  <p class="text-xs text-[var(--ink-tertiary)] italic font-mono col-span-2">No input fields required for this action.</p>
                {/each}
              </div>
            {:else}
              <div class="p-4">
                <textarea bind:value={jsonInput} oninput={validateClientSide} rows="6" class="w-full bg-[var(--bg)] border border-[var(--border)] p-3 font-mono text-xs text-[var(--ink)] focus-ring leading-relaxed"></textarea>
              </div>
            {/if}

            <div class="p-3 border-t border-[var(--border)] bg-[var(--bg-elevated)] flex items-center justify-between">
              <span class="text-[11px] font-mono text-[var(--ink-tertiary)]">Transports: HTTP/3 · ConnectRPC · NATS · MQTT</span>
              <button onclick={executeAction} disabled={isExecuting} class="px-5 py-2 rounded bg-[var(--accent)] hover:opacity-90 text-[#0c0c0e] font-mono text-xs font-bold tracking-wider uppercase transition-all shadow-md focus-ring flex items-center gap-2 cursor-pointer disabled:opacity-50">
                {#if isExecuting}
                  <span>⏳ EXECUTING...</span>
                {:else}
                  <span>▶ Execute Action</span>
                {/if}
              </button>
            </div>
          </div>

          <!-- Code Snippets Generator -->
          <div class="border border-[var(--border)] bg-[var(--bg-raised)]">
            <div class="px-4 py-2 border-b border-[var(--border)] bg-[var(--bg-elevated)] flex items-center justify-between">
              <div class="flex gap-4 font-mono text-xs">
                <button onclick={() => snippetLang = 'curl'} class="snippet-tab {snippetLang === 'curl' ? 'text-[var(--accent)] border-b border-[var(--accent)] font-semibold' : 'text-[var(--ink-tertiary)] hover:text-[var(--ink)]'} pb-0.5">cURL</button>
                <button onclick={() => snippetLang = 'ts'} class="snippet-tab {snippetLang === 'ts' ? 'text-[var(--accent)] border-b border-[var(--accent)] font-semibold' : 'text-[var(--ink-tertiary)] hover:text-[var(--ink)]'} pb-0.5">TypeScript SDK</button>
                <button onclick={() => snippetLang = 'go'} class="snippet-tab {snippetLang === 'go' ? 'text-[var(--accent)] border-b border-[var(--accent)] font-semibold' : 'text-[var(--ink-tertiary)] hover:text-[var(--ink)]'} pb-0.5">Go Edge Mesh</button>
                <button onclick={() => snippetLang = 'fetch'} class="snippet-tab {snippetLang === 'fetch' ? 'text-[var(--accent)] border-b border-[var(--accent)] font-semibold' : 'text-[var(--ink-tertiary)] hover:text-[var(--ink)]'} pb-0.5">Fetch</button>
              </div>
              <button onclick={() => copyToClipboard(generatedSnippet)} class="text-[10px] font-mono text-[var(--ink-tertiary)] hover:text-[var(--ink)] focus-ring">
                {copiedSnippet ? '[ ✓ COPIED ]' : '[ COPY SNIPPET ]'}
              </button>
            </div>
            <pre class="p-3.5 font-mono text-xs text-[var(--ink)] bg-[var(--bg)] overflow-x-auto leading-relaxed">{generatedSnippet}</pre>
          </div>
        {/if}
      </section>

      <!-- RIGHT PANE: Execution Console & Timeline (320px) -->
      <aside class="w-80 flex-shrink-0 bg-[var(--bg-raised)] border-l border-[var(--border)] flex flex-col overflow-hidden hidden lg:flex">
        <div class="p-3 border-b border-[var(--border)] bg-[var(--bg-elevated)] flex items-center justify-between">
          <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-[var(--ink-secondary)]">Live Response</span>
          {#if responseStatus !== null}
            <div class="flex items-center gap-2 font-mono text-[10px]">
              <span class="pill {responseStatus >= 200 && responseStatus < 300 ? 'pill-green' : 'pill-red'}">HTTP {responseStatus}</span>
              <span class="text-[var(--ink-tertiary)]">{executionTimeMs}ms</span>
            </div>
          {/if}
        </div>

        {#if responseData && (responseData.router_trace || responseData.attempts || responseData.trace || responseData.revision_rounds)}
          <div class="p-3 border-b border-[var(--border)] bg-[var(--bg)] flex flex-col gap-1.5 font-mono text-xs">
            <div class="text-[10px] uppercase text-[var(--ink-tertiary)] tracking-wider mb-1">Execution Timeline</div>
            {#each responseData.trace || responseData.attempts || [] as step, idx}
              <div class="flex justify-between text-[11px]">
                <span class="text-[var(--ink)]">{idx + 1}. {step.provider || step.model || 'Step'}</span>
                <span class="text-[var(--accent)]">{step.duration_ms || 0}ms</span>
              </div>
            {/each}
          </div>
        {/if}

        {#if responseData && (responseData.error || responseData.message || responseData.cause)}
          <div class="p-3 border-b border-[var(--border)] bg-[var(--negative-dim)] font-mono text-xs space-y-1">
            <div class="flex items-center gap-1.5 text-[var(--negative)] font-bold">
              <span>❌ [{responseData.error || 'Error'}]</span>
            </div>
            <p class="text-[var(--ink)] text-[11px]">{responseData.message || ''}</p>
            {#if responseData.cause}
              <div class="text-[10px] text-[var(--negative)] pt-1 border-t border-[var(--border)]">Cause: {responseData.cause}</div>
            {/if}
          </div>
        {/if}

        <div class="flex-1 flex flex-col min-h-0 bg-[var(--bg)] p-3 overflow-y-auto">
          <pre class="font-mono text-xs text-[var(--ink)] leading-relaxed flex-1">{responseData ? JSON.stringify(responseData, null, 2) : 'Ready for execution...'}</pre>
        </div>
      </aside>

    {:else if activeTab === 'errors'}
      <!-- 🚨 REAL-TIME BACKEND ERRORS -->
      <section class="flex-1 bg-[var(--bg)] p-6 overflow-y-auto space-y-4 max-w-5xl mx-auto w-full">
        <div class="p-3 bg-[var(--bg-raised)] border border-[var(--border)] flex justify-between items-center font-mono">
          <span class="text-xs font-bold text-[var(--negative)]">🚨 Live Error Ring Buffer</span>
          <button onclick={loadBackendErrors} class="px-2.5 py-1 text-xs border border-[var(--border)] bg-[var(--bg-elevated)] hover:bg-[var(--bg-hover)]">Refresh</button>
        </div>
        {#each backendErrors as errItem}
          <div class="p-4 bg-[var(--bg-raised)] border border-[var(--border)] font-mono text-xs space-y-2">
            <div class="flex justify-between border-b border-[var(--border)] pb-2 text-[var(--ink-tertiary)]">
              <span class="pill pill-red">{errItem.action}</span>
              <span>{errItem.timestamp}</span>
            </div>
            <p class="text-[var(--negative)] font-bold">{errItem.message}</p>
            {#if errItem.details}<p class="text-[var(--accent)]">{errItem.details}</p>{/if}
            {#if errItem.stack_trace}<pre class="p-2 bg-[var(--bg)] text-[10px] text-[var(--ink-secondary)] overflow-x-auto">{errItem.stack_trace}</pre>{/if}
          </div>
        {:else}
          <div class="p-12 text-center text-xs text-[var(--ink-tertiary)] font-mono border border-[var(--border)] bg-[var(--bg-raised)]">No runtime errors captured. All actions healthy.</div>
        {/each}
      </section>

    {:else if activeTab === 'history'}
      <!-- 📜 BACKEND REQUEST HISTORY -->
      <section class="flex-1 bg-[var(--bg)] p-6 overflow-y-auto space-y-4 max-w-5xl mx-auto w-full">
        <div class="p-3 bg-[var(--bg-raised)] border border-[var(--border)] flex justify-between items-center font-mono">
          <span class="text-xs font-bold text-[var(--accent)]">📜 Request History (All Transports)</span>
          <button onclick={loadBackendRequests} class="px-2.5 py-1 text-xs border border-[var(--border)] bg-[var(--bg-elevated)] hover:bg-[var(--bg-hover)]">Refresh</button>
        </div>
        <div class="border border-[var(--border)] bg-[var(--bg-raised)] overflow-hidden">
          <table class="w-full text-left text-xs font-mono">
            <thead class="bg-[var(--bg-elevated)] text-[var(--ink-tertiary)] border-b border-[var(--border)]">
              <tr><th class="p-2.5">Time</th><th class="p-2.5">Action</th><th class="p-2.5">Status</th><th class="p-2.5">Latency</th><th class="p-2.5">Error</th></tr>
            </thead>
            <tbody class="divide-y divide-[var(--border)] text-[var(--ink-secondary)]">
              {#each backendRequests as r}
                <tr>
                  <td class="p-2.5">{r.first_seen}</td>
                  <td class="p-2.5 font-bold text-[var(--ink)]">{r.action}</td>
                  <td class="p-2.5"><span class="pill {r.status === 'success' ? 'pill-green' : 'pill-red'}">{r.status}</span></td>
                  <td class="p-2.5">{r.duration_ms}ms</td>
                  <td class="p-2.5 text-[var(--negative)] truncate max-w-xs">{r.error_msg || '-'}</td>
                </tr>
              {:else}
                <tr><td colspan="5" class="p-8 text-center text-[var(--ink-tertiary)] italic">No requests recorded yet.</td></tr>
              {/each}
            </tbody>
          </table>
        </div>
      </section>

    {:else if activeTab === 'topology'}
      <!-- 🗺️ VISUAL SERVICE MESH TOPOLOGY -->
      <section class="flex-1 bg-[var(--bg)] p-6 overflow-y-auto space-y-4 max-w-5xl mx-auto w-full">
        <div class="p-3 bg-[var(--bg-raised)] border border-[var(--border)] flex justify-between items-center font-mono">
          <span class="text-xs font-bold text-[var(--accent)]">🗺️ Service Mesh Topology</span>
          <a href="/deploy/architecture" target="_blank" class="px-2.5 py-1 text-xs border border-[var(--border)] bg-[var(--bg-elevated)] text-[var(--accent)] hover:bg-[var(--bg-hover)]">Open Pan-Zoom Map ↗</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 font-mono text-xs">
          {#each topologyNodes as node}
            <div class="border border-[var(--border)] bg-[var(--bg-raised)] p-4 space-y-2">
              <div class="border-b border-[var(--border)] pb-2 flex justify-between text-[var(--accent)] font-bold">
                <span>🖥️ {node.nodeName}</span>
                <span class="text-[10px] text-[var(--ink-tertiary)]">{node.eps.length} Actions</span>
              </div>
              {#each node.eps as ep}
                <div class="p-2 bg-[var(--bg)] border border-[var(--border)] flex justify-between">
                  <span class="text-[var(--ink)] font-bold">{ep.name}</span>
                  <span class="pill pill-green text-[9px]">{ep.method}</span>
                </div>
              {/each}
            </div>
          {/each}
        </div>
      </section>

    {:else if activeTab === 'telemetry'}
      <!-- 📊 SYSTEM TELEMETRY -->
      <section class="flex-1 bg-[var(--bg)] p-6 overflow-y-auto space-y-4 max-w-5xl mx-auto w-full">
        <div class="p-3 bg-[var(--bg-raised)] border border-[var(--border)] flex justify-between items-center font-mono">
          <span class="text-xs font-bold text-[var(--accent)]">📊 Live Resource Telemetry</span>
          <button onclick={loadTelemetry} class="px-2.5 py-1 text-xs border border-[var(--border)] bg-[var(--bg-elevated)] hover:bg-[var(--bg-hover)]">Refresh</button>
        </div>
        {#if systemMetrics}
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 font-mono">
            <div class="p-4 bg-[var(--bg-raised)] border border-[var(--border)]"><span class="text-[10px] text-[var(--ink-tertiary)] uppercase block">CPU</span><strong class="text-xl text-[var(--positive)]">{systemMetrics.cpu_percent?.toFixed(1) || 0}%</strong></div>
            <div class="p-4 bg-[var(--bg-raised)] border border-[var(--border)]"><span class="text-[10px] text-[var(--ink-tertiary)] uppercase block">Memory</span><strong class="text-xl text-[var(--accent)]">{systemMetrics.memory_used_mb || 0} MB</strong></div>
            <div class="p-4 bg-[var(--bg-raised)] border border-[var(--border)]"><span class="text-[10px] text-[var(--ink-tertiary)] uppercase block">Goroutines</span><strong class="text-xl text-[var(--ink)]">{systemMetrics.goroutines || 0}</strong></div>
            <div class="p-4 bg-[var(--bg-raised)] border border-[var(--border)]"><span class="text-[10px] text-[var(--ink-tertiary)] uppercase block">Uptime</span><strong class="text-xl text-[var(--ink)]">{Math.floor((systemMetrics.uptime_sec || 0)/60)}m</strong></div>
          </div>
        {/if}
      </section>
    {/if}

  </main>

  <!-- ── 3. DTO SCHEMA MODAL (Table / TS / Go) ── -->
  {#if activeSchemaModal && currentMeta}
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm p-4" role="dialog" aria-modal="true">
      <div class="w-full max-w-2xl bg-[var(--bg-raised)] border border-[var(--border-strong)] p-5 space-y-4 shadow-2xl">
        <div class="flex items-center justify-between border-b border-[var(--border)] pb-3">
          <div class="flex items-center gap-3">
            <span class="font-mono text-xs text-[var(--accent)] font-bold">Schema: <span class="text-[var(--ink)]">{activeSchemaModal === 'req' ? currentMeta.reqType : currentMeta.resType}</span></span>
            <div class="flex border border-[var(--border)] bg-[var(--bg)] p-0.5 text-[10px] font-mono">
              <button onclick={() => schemaViewMode = 'table'} class="px-2 py-0.5 rounded {schemaViewMode === 'table' ? 'bg-[var(--bg-elevated)] text-[var(--accent)] font-bold' : 'text-[var(--ink-tertiary)]'}">Table View</button>
              <button onclick={() => schemaViewMode = 'ts'} class="px-2 py-0.5 rounded {schemaViewMode === 'ts' ? 'bg-[var(--bg-elevated)] text-[var(--accent)] font-bold' : 'text-[var(--ink-tertiary)]'}">TypeScript</button>
              <button onclick={() => schemaViewMode = 'go'} class="px-2 py-0.5 rounded {schemaViewMode === 'go' ? 'bg-[var(--bg-elevated)] text-[var(--accent)] font-bold' : 'text-[var(--ink-tertiary)]'}">Go Struct</button>
            </div>
          </div>
          <button onclick={() => activeSchemaModal = null} class="text-xs text-[var(--ink-tertiary)] hover:text-[var(--ink)] font-mono">[ ESC / CLOSE ]</button>
        </div>

        {#if schemaViewMode === 'table'}
          <div class="max-h-80 overflow-y-auto border border-[var(--border)]">
            <table class="w-full text-left text-xs font-mono">
              <thead class="bg-[var(--bg-elevated)] text-[var(--ink-tertiary)] border-b border-[var(--border)]">
                <tr><th class="p-2.5">Field</th><th class="p-2.5">Type</th><th class="p-2.5">Required</th><th class="p-2.5">Rules</th></tr>
              </thead>
              <tbody class="divide-y divide-[var(--border)] text-[var(--ink-secondary)]">
                {#each activeSchemaFields as f}
                  <tr>
                    <td class="p-2.5 font-bold text-[var(--accent)]">{f.key}</td>
                    <td class="p-2.5 text-[var(--positive)]">{f.type}</td>
                    <td class="p-2.5">{#if f.required}<span class="text-[var(--negative)] font-bold">YES</span>{:else}<span class="text-[var(--ink-tertiary)]">NO</span>{/if}</td>
                    <td class="p-2.5 text-[var(--ink-secondary)]">{f.validation || '-'}</td>
                  </tr>
                {/each}
              </tbody>
            </table>
          </div>
        {:else if schemaViewMode === 'ts'}
          <pre class="max-h-80 p-3.5 bg-[var(--bg)] border border-[var(--border)] font-mono text-xs text-[var(--ink)] overflow-x-auto leading-relaxed">{generateTSInterfaceCode(activeSchemaModal === 'req' ? currentMeta.reqType : currentMeta.resType, activeSchemaFields)}</pre>
        {:else if schemaViewMode === 'go'}
          <pre class="max-h-80 p-3.5 bg-[var(--bg)] border border-[var(--border)] font-mono text-xs text-[var(--positive)] overflow-x-auto leading-relaxed">{generateGoStructCode(activeSchemaModal === 'req' ? currentMeta.reqType : currentMeta.resType, activeSchemaFields)}</pre>
        {/if}
      </div>
    </div>
  {/if}

</div>
