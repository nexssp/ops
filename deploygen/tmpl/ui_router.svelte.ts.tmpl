/**
 * Scaffolded by Nexss.
 * A lightweight, zero-dependency Regex Router using Svelte 5 Runes.
 */

const routes: Record<string, any> = {};

export const routerState = $state({
    path: window.location.pathname,
    component: null as any,
    props: {} as Record<string, any>,
});

const PUBLIC_PATHS = ['/', '/login', '/health'];

export function isPublicPath(path: string) {
    const clean = path.split('?')[0].replace(/\/$/, '');
    return PUBLIC_PATHS.some((p) => clean === p || clean.startsWith(p + '/') || clean === p);
}

function isAuthenticated() {
  const token = localStorage.getItem('access_token');
  return token && token !== 'undefined' && token !== 'null';
}

function matchRoute(path: string) {
  for (const [pattern, component] of Object.entries(routes)) {
    const regex = new RegExp('^' + pattern.replace(/:[^/]+/g, '([^/]+)') + '$');
    const match = path.match(regex);
    if (match) {
      const params: Record<string, string> = {};
      const keys = (pattern.match(/:[^/]+/g) || []).map((k) => k.slice(1));
      keys.forEach((k, i) => { params[k] = match[i + 1]; });
      return { component, params };
    }
  }
  return { component: null, params: {} };
}

export function navigate(url: string) {
  const pathname = url.split('?')[0].split('#')[0];
  if (!isPublicPath(pathname) && !isAuthenticated()) {
    const returnTo = encodeURIComponent(url);
    window.history.pushState({}, '', `/login?returnTo=${returnTo}`);
    updateRoute();
    return;
  }
  window.history.pushState({}, '', url);
  updateRoute();
}

export function updateRoute() {
  const currentPath = window.location.pathname;
  if (!isPublicPath(currentPath) && !isAuthenticated()) {
    if (currentPath !== '/login') {
      navigate('/login');
      return;
    }
  }
  const { component, params } = matchRoute(currentPath);
  routerState.path = currentPath;
  routerState.component = component;
  routerState.props = { params };
}

export function startRouter() {
  window.addEventListener('popstate', updateRoute);
  updateRoute();
}
