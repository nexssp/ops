import { getAuthHeader } from './client';

export const customApi = {
    initAuth: () => {
        const access = localStorage.getItem('access_token');
        const refresh = localStorage.getItem('refresh_token');
        return { hasAccess: !!access, hasRefresh: !!refresh };
    }
};
